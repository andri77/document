{
  "info": {
    "name": "Invoice API",
    "_postman_id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80",
    "description": "XML and PDF invoice API tests for the Invoice Demo App.\n\n**Before running:** start the Sinatra app on port 4567.\n\nRequests run in order — step 1 creates an invoice and stores its ID in `{{invoiceId}}` for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4567",
      "type": "string",
      "description": "Base URL of the running Sinatra app"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Create Invoice request"
    }
  ],
  "item": [
    {
      "name": "1. Create Invoice",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response body is valid JSON', () => {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Response contains a numeric invoice ID', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.expect(body.id).to.be.above(0);",
              "    pm.collectionVariables.set('invoiceId', body.id);",
              "    console.log('Invoice ID stored:', body.id);",
              "});",
              "",
              "pm.test('Invoice status is Generated', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('Generated');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_name\": \"Acme Corp\",\n  \"currency\": \"AUD\",\n  \"amount\": 1500.00,\n  \"item_count\": 1,\n  \"unit_price\": 1500.00\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/invoices",
          "host": ["{{baseUrl}}"],
          "path": ["api", "invoices"]
        },
        "description": "Creates a single-line-item invoice for Acme Corp. Stores the returned `id` as `{{invoiceId}}` for use in subsequent requests."
      },
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"Acme Corp\",\n  \"currency\": \"AUD\",\n  \"amount\": 1500.00,\n  \"item_count\": 1,\n  \"unit_price\": 1500.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invoices" }
          },
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"id\": 1,\n  \"status\": \"Generated\"\n}"
        }
      ]
    },
    {
      "name": "2. Get XML Invoice — Structure",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type is application/xml', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml');",
              "});",
              "",
              "pm.test('Response body is valid XML', () => {",
              "    pm.expect(() => xml2Json(pm.response.text())).to.not.throw();",
              "});",
              "",
              "const xml = xml2Json(pm.response.text());",
              "const invoice = xml.Invoice;",
              "",
              "pm.test('Root element is Invoice with version 1.0', () => {",
              "    pm.expect(invoice).to.exist;",
              "    pm.expect(invoice._attributes.version).to.eql('1.0');",
              "});",
              "",
              "pm.test('Client/Name is Acme Corp', () => {",
              "    pm.expect(invoice.Client.Name).to.eql('Acme Corp');",
              "});",
              "",
              "pm.test('Currency is AUD', () => {",
              "    pm.expect(invoice.Currency).to.eql('AUD');",
              "});",
              "",
              "pm.test('LineItems contains at least one Item', () => {",
              "    const items = invoice.LineItems.Item;",
              "    pm.expect(items).to.exist;",
              "});",
              "",
              "pm.test('Item has Description, UnitPrice and Quantity', () => {",
              "    const item = Array.isArray(invoice.LineItems.Item)",
              "        ? invoice.LineItems.Item[0]",
              "        : invoice.LineItems.Item;",
              "    pm.expect(item.Description).to.eql('Service Item 1');",
              "    pm.expect(item.UnitPrice).to.eql('1500.0');",
              "    pm.expect(item.Quantity).to.eql('1');",
              "});",
              "",
              "pm.test('Total is 1500.0', () => {",
              "    pm.expect(invoice.Total).to.eql('1500.0');",
              "});",
              "",
              "pm.test('Status is Generated', () => {",
              "    pm.expect(invoice.Status).to.eql('Generated');",
              "});",
              "",
              "pm.test('GeneratedAt is present', () => {",
              "    pm.expect(invoice.GeneratedAt).to.be.a('string');",
              "    pm.expect(invoice.GeneratedAt.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/xml",
          "host": ["{{baseUrl}}"],
          "path": ["api", "invoices", "{{invoiceId}}", "xml"]
        },
        "description": "Downloads the XML representation of the invoice created in request 1. Validates the full document structure, all element values, and the Content-Type header."
      },
      "response": [
        {
          "name": "200 OK — XML Invoice",
          "status": "OK",
          "code": 200,
          "originalRequest": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices/1/xml" }
          },
          "header": [{ "key": "Content-Type", "value": "application/xml;charset=utf-8" }],
          "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Invoice version=\"1.0\">\n  <Client>\n    <Name>Acme Corp</Name>\n  </Client>\n  <Currency>AUD</Currency>\n  <LineItems>\n    <Item number=\"1\">\n      <Description>Service Item 1</Description>\n      <UnitPrice>1500.0</UnitPrice>\n      <Quantity>1</Quantity>\n    </Item>\n  </LineItems>\n  <Total>1500.0</Total>\n  <Status>Generated</Status>\n  <GeneratedAt>2026-05-06 00:00:00 UTC</GeneratedAt>\n</Invoice>"
        }
      ]
    },
    {
      "name": "3. Get XML Invoice — Multiple Line Items",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Create a 3-item invoice and store its ID before running this request.",
              "// The GET url below is updated in the test script once the ID is known.",
              "const baseUrl = pm.collectionVariables.get('baseUrl');",
              "",
              "pm.sendRequest({",
              "    url: baseUrl + '/api/invoices',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({",
              "            client_name: 'Globex Ltd',",
              "            currency: 'USD',",
              "            amount: 750.00,",
              "            item_count: 3,",
              "            unit_price: 250.00",
              "        })",
              "    }",
              "}, (err, res) => {",
              "    const id = res.json().id;",
              "    pm.collectionVariables.set('multiItemInvoiceId', id);",
              "    console.log('Multi-item invoice ID:', id);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type is application/xml', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml');",
              "});",
              "",
              "const xml = xml2Json(pm.response.text());",
              "const invoice = xml.Invoice;",
              "",
              "pm.test('Currency is USD', () => {",
              "    pm.expect(invoice.Currency).to.eql('USD');",
              "});",
              "",
              "pm.test('LineItems contains 3 Item elements', () => {",
              "    const items = invoice.LineItems.Item;",
              "    pm.expect(Array.isArray(items)).to.be.true;",
              "    pm.expect(items.length).to.eql(3);",
              "});",
              "",
              "pm.test('Items are numbered 1 to 3', () => {",
              "    const items = invoice.LineItems.Item;",
              "    pm.expect(items[0]._attributes.number).to.eql('1');",
              "    pm.expect(items[1]._attributes.number).to.eql('2');",
              "    pm.expect(items[2]._attributes.number).to.eql('3');",
              "});",
              "",
              "pm.test('Each item has UnitPrice of 250.0', () => {",
              "    invoice.LineItems.Item.forEach(item => {",
              "        pm.expect(item.UnitPrice).to.eql('250.0');",
              "        pm.expect(item.Quantity).to.eql('1');",
              "    });",
              "});",
              "",
              "pm.test('Total is 750.0 (3 x 250.0)', () => {",
              "    pm.expect(invoice.Total).to.eql('750.0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/invoices/{{multiItemInvoiceId}}/xml",
          "host": ["{{baseUrl}}"],
          "path": ["api", "invoices", "{{multiItemInvoiceId}}", "xml"]
        },
        "description": "Creates a 3-item invoice via pre-request script, then fetches its XML. Validates that all three Item elements are present, correctly numbered, and that Total equals 3 × 250.0 = 750.0."
      },
      "response": [
        {
          "name": "200 OK — 3-Item XML Invoice",
          "status": "OK",
          "code": 200,
          "originalRequest": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices/2/xml" }
          },
          "header": [{ "key": "Content-Type", "value": "application/xml;charset=utf-8" }],
          "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Invoice version=\"1.0\">\n  <Client>\n    <Name>Globex Ltd</Name>\n  </Client>\n  <Currency>USD</Currency>\n  <LineItems>\n    <Item number=\"1\">\n      <Description>Service Item 1</Description>\n      <UnitPrice>250.0</UnitPrice>\n      <Quantity>1</Quantity>\n    </Item>\n    <Item number=\"2\">\n      <Description>Service Item 2</Description>\n      <UnitPrice>250.0</UnitPrice>\n      <Quantity>1</Quantity>\n    </Item>\n    <Item number=\"3\">\n      <Description>Service Item 3</Description>\n      <UnitPrice>250.0</UnitPrice>\n      <Quantity>1</Quantity>\n    </Item>\n  </LineItems>\n  <Total>750.0</Total>\n  <Status>Generated</Status>\n  <GeneratedAt>2026-05-06 00:00:00 UTC</GeneratedAt>\n</Invoice>"
        }
      ]
    },
    {
      "name": "4. Get XML Invoice — Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404 Not Found', () => {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Response body contains not found message', () => {",
              "    pm.expect(pm.response.text()).to.include('not found');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/invoices/99999/xml",
          "host": ["{{baseUrl}}"],
          "path": ["api", "invoices", "99999", "xml"]
        },
        "description": "Requests XML for a non-existent invoice ID. Expects a 404 response with a message indicating the invoice was not found."
      },
      "response": [
        {
          "name": "404 Not Found",
          "status": "Not Found",
          "code": 404,
          "originalRequest": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices/99999/xml" }
          },
          "header": [],
          "body": "Invoice not found"
        }
      ]
    },
    {
      "name": "5. Get XML — Total Calculation Variants",
      "item": [
        {
          "name": "5a. 1 item × 100.0 = 100.0",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/invoices',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ client_name: 'Test', currency: 'AUD', amount: 100.0, item_count: 1, unit_price: 100.0 }) }",
                  "}, (err, res) => { pm.collectionVariables.set('calcInvoiceId', res.json().id); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const invoice = xml2Json(pm.response.text()).Invoice;",
                  "pm.test('Total is 100.0', () => pm.expect(invoice.Total).to.eql('100.0'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{calcInvoiceId}}/xml",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{calcInvoiceId}}", "xml"]
            }
          }
        },
        {
          "name": "5b. 3 items × 250.0 = 750.0",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/invoices',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ client_name: 'Test', currency: 'AUD', amount: 750.0, item_count: 3, unit_price: 250.0 }) }",
                  "}, (err, res) => { pm.collectionVariables.set('calcInvoiceId', res.json().id); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const invoice = xml2Json(pm.response.text()).Invoice;",
                  "pm.test('Total is 750.0', () => pm.expect(invoice.Total).to.eql('750.0'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{calcInvoiceId}}/xml",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{calcInvoiceId}}", "xml"]
            }
          }
        },
        {
          "name": "5c. 5 items × 99.99 = 499.95",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/invoices',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ client_name: 'Test', currency: 'AUD', amount: 499.95, item_count: 5, unit_price: 99.99 }) }",
                  "}, (err, res) => { pm.collectionVariables.set('calcInvoiceId', res.json().id); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const invoice = xml2Json(pm.response.text()).Invoice;",
                  "pm.test('Total is 499.95 (rounds correctly)', () => pm.expect(invoice.Total).to.eql('499.95'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{calcInvoiceId}}/xml",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{calcInvoiceId}}", "xml"]
            }
          }
        }
      ]
    }
  ]
}
